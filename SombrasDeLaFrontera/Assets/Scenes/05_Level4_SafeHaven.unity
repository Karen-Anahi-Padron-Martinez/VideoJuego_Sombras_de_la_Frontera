  m_Script: {fileID: 11500000, guid: e1f82b934cd7428fb17382046ac81290, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndGameModalController
  gameOverPanel: {fileID: 1787082571}
  gameOverTitleText: {fileID: 730894126}
  gameOverDescriptionText: {fileID: 757554637}
  retryButton: {fileID: 2111249741}
  gameOverMenuButton: {fileID: 625241780}
  defeatByFlashlight:
    title: "\xA1HAS SIDO DESCUBIERTO!"
    titleColor: {r: 0.95, g: 0.22, b: 0.22, a: 1}
    description: "La linterna de un agente de la redada ilumin\xF3 tu silueta.\n\n\U0001F4E6 <b>Consejo:</b> Esc\xF3ndete tras rocas, autos oxidados o costales; las cercas y los \xE1rboles secos no te cubren."
  defeatByDehydration:
    title: "\xA1COLAPSO POR DESHIDRATACI\xD3N!"
    titleColor: {r: 0.95, g: 0.55, b: 0.15, a: 1}
    description: "La \xFAltima noche de camino agot\xF3 tu \xFAltima gota de agua.\n\n\U0001F4A7 <b>Consejo:</b> Busca agua en el camino antes de que se acabe."
  defeatBySnake:
    title: "\xA1MORDEDURA DE SERPIENTE!"
    titleColor: {r: 0.6, g: 0.85, b: 0.25, a: 1}
    description: "Una v\xEDbora de cascabel te mordi\xF3 al pisar su territorio.\n\n\U0001F40D <b>Consejo:</b> Escucha el sonido del cascabel y dale un amplio rodeo a su zona."
  defeatByScorpion:
    title: "\xA1PICADURA DE ALACR\xC1N!"
    titleColor: {r: 0.85, g: 0.35, b: 0.85, a: 1}
    description: "Un alacr\xE1n venenoso te clav\xF3 su aguij\xF3n entre las piedras.\n\n\U0001F982 <b>Consejo:</b> Mira bien el suelo y no te detengas sobre madrigueras de fauna nociva."
  defeatByDog:
    title: "\xA1ACORRALADO POR PERROS!"
    titleColor: {r: 0.92, g: 0.32, b: 0.18, a: 1}
    description: "Los perros K-9 te mordieron y sus ladridos alertaron a los agentes.\n\n\U0001F415 <b>Consejo:</b> Los perros vigilan en semic\xEDrculo frontal; pasa por detr\xE1s o ag\xE1chate a cubierto."
  defeatBySpider:
    title: "\xA1PICADURA DE ARA\xD1A!"
    titleColor: {r: 0.75, g: 0.45, b: 0.25, a: 1}
    description: "Una tar\xE1ntula del desierto te pic\xF3 cuando pasaste junto a su madriguera.\n\n<b>Consejo:</b> Si la ves levantar las patas, al\xE9jate de inmediato: est\xE1 a punto de atacar."
  defeatBySearchlight:
    title: "\xA1EL REFLECTOR TE DESCUBRI\xD3!"
    titleColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    description: "El haz de la torre de vigilancia te alumbr\xF3 en campo abierto.\n\n\U0001F5FC <b>Consejo:</b> Observa el barrido del reflector, cruza cuando se aleje y ag\xE1chate tras un obst\xE1culo: su luz no pasa a trav\xE9s de ellos."
  defeatByRiverPredator:
    title: "\xA1ATACADO EN EL R\xCDO!"
    titleColor: {r: 0.45, g: 0.75, b: 0.7, a: 1}
    description: "Un pejelagarto te mordi\xF3 mientras cruzabas el R\xEDo Bravo.\n\n\U0001F40A <b>Consejo:</b> Observa su recorrido de lado a lado y cruza por detr\xE1s de \xE9l cuando se aleje."
  defeatByWaterSnake:
    title: "\xA1MORDEDURA DE SERPIENTE DE AGUA!"
    titleColor: {r: 0.6, g: 0.85, b: 0.25, a: 1}
    description: "Una serpiente de agua te mordi\xF3 al cruzarte en su camino.\n\n\U0001F40D <b>Consejo:</b> Nada en zigzag de orilla a orilla; espera a que se aleje antes de pasar."
  defeatByBoat:
    title: "\xA1LA LANCHA TE DESCUBRI\xD3!"
    titleColor: {r: 1, g: 0.85, b: 0.35, a: 1}
    description: "El reflector de la Patrulla Fronteriza te alumbr\xF3 nadando en la superficie.\n\n\U0001F6A4 <b>Consejo:</b> Cuando veas el brillo en la orilla, esc\xF3ndete bajo un tronco o entre los juncos, o sum\xE9rgete hasta que pase la luz."
  defeatByBarbedWire:
    title: "\xA1ATRAPADO EN EL ALAMBRE DE P\xDAAS!"
    titleColor: {r: 0.75, g: 0.75, b: 0.8, a: 1}
    description: "Las p\xFAas del alambrado bajo el agua te hirieron una y otra vez.\n\n\U0001F6A7 <b>Consejo:</b> Cada alambrado tiene un hueco; b\xFAscalo con calma y no nades pegado a las p\xFAas."
  defeatByDrowning:
    title: "\xA1TE QUEDASTE SIN AIRE!"
    titleColor: {r: 0.35, g: 0.7, b: 1, a: 1}
    description: "Mateo se qued\xF3 demasiado tiempo bajo el agua y no alcanz\xF3 a salir a respirar.\n\n\U0001F93F <b>Consejo:</b> Vigila la barra de aire: sum\xE9rgete solo mientras pasa la luz y sal a la superficie antes de que se vac\xEDe. Los carrizos te dan aire extra."
  defeatGeneric:
    title: "\xA1TE HAS QUEDADO SIN VIDAS!"
    titleColor: {r: 0.9, g: 0.2, b: 0.2, a: 1}
    description: "Mateo ha perdido sus 3 corazones a unos pasos del refugio.\n\n\U0001F6E1\uFE0F <b>Consejo:</b> Protege tu salud y administra bien tus movimientos."
  victoryPanel: {fileID: 115007318}
  nextLevelButton: {fileID: 1987079199}
  victoryMenuButton: {fileID: 989575021}
  mainMenuSceneName: 01_MainMenu
  nextLevelSceneName: 01_MainMenu
