%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c0f94c52932d2a14c874da6652bccada, type: 3}
  m_Name: Final
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneData
  siguienteEscena: 01_MainMenu
  pasos:
  - tipo: 0
    texto: "Ya casi amanece. Mateo lleva tres noches caminando por el desierto del otro lado y ya no tiene agua. La br\xFAjula se rompi\xF3 en la frontera, as\xED que se gu\xEDa por la Estrella Polar, como le ense\xF1\xF3 su padre."
    imagen: {fileID: 0}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 1
    texto: 
    imagen: {fileID: 21300000, guid: 3cc6e17d342220f48a88f94d5e164e42, type: 3}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 0
    texto: "Sube el \xFAltimo cerro arrastrando los pies y cae de rodillas en la cima. Abajo, a lo lejos, se ven las luces de un pueblo y una carretera que corta el desierto en l\xEDnea recta."
    imagen: {fileID: 0}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 1
    texto: 
    imagen: {fileID: 21300000, guid: dd9d481bee5e30040aad09cd23ac8919, type: 3}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 0
    texto: "Mateo saca la br\xFAjula rota y la mira. Piensa en su madre, sola en la casa de adobe."
    imagen: {fileID: 0}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 1
    texto: 
    imagen: {fileID: 21300000, guid: be7c1d647349bf345a433008bdc03b6d, type: 3}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 0
    texto: "Por primera vez en todo el viaje, Mateo sonr\xEDe. Baja el cerro y llega a la orilla de la carretera. A lo lejos aparecen dos faros que se acercan despacio."
    imagen: {fileID: 0}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 1
    texto: 
    imagen: {fileID: 21300000, guid: b405770055ebeb04f8e87ba50f237738, type: 3}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 0
    texto: "Los faros lo iluminan de frente y el veh\xEDculo se detiene. Se abre una puerta. Mateo aprieta la br\xFAjula en su mano."
    imagen: {fileID: 0}
    duracion: 0
    ambiente: {fileID: 0}
    velocidadTexto: 1
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 0
    texto: "Cada a\xF1o, miles de personas cruzan estas sombras. Todas creen que al final del camino algo va a cambiar."
    imagen: {fileID: 0}
    duracion: 3
    ambiente: {fileID: 0}
    velocidadTexto: 0.5
    tamanoTexto: 0
    duracionFade: 0
  - tipo: 0
    texto: FIN
    imagen: {fileID: 0}
    duracion: 4
    ambiente: {fileID: 0}
    velocidadTexto: 0
    tamanoTexto: 160
    duracionFade: 2.5
